# Voyage Analytics 2.0 — Streamlit Dashboard Dockerfile

FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY dashboard/ ./dashboard/
COPY src/ ./src/
COPY data/processed/ ./data/processed/
COPY models/registry/ ./models/registry/
COPY .env.example .env

RUN adduser --disabled-password --gecos "" dashuser && \
    chown -R dashuser:dashuser /app
USER dashuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s CMD \
    python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"

CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
